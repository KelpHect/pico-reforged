{
  "name": "@rusticstack/pico-reforged",
  "version": "1.0.0-alpha.0",
  "description": "Pico CSS rewritten in plain modern CSS: minimal styles for semantic HTML, with a small compiler for themes, scoping and purging",
  "author": "rusticstack",
  "license": "MIT",
  "homepage": "https://pico.rusticstack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusticstack/pico-reforged.git"
  },
  "bugs": {
    "url": "https://github.com/rusticstack/pico-reforged/issues"
  },
  "type": "module",
  "main": "css/pico.min.css",
  "style": "css/pico.min.css",
  "bin": {
    "pico-reforged": "dist/cli.js"
  },
  "files": [
    "css",
    "src",
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": "./css/pico.min.css",
    "./css/*": "./css/*",
    "./src/*": "./src/*",
    "./compiler": {
      "types": "./dist/lib/compiler/index.d.ts",
      "default": "./dist/lib/compiler/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run generate && node scripts/cli.ts matrix css",
    "generate": "node scripts/generate.ts",
    "dev": "node --watch-path=src --watch-path=scripts scripts/dev-build.ts",
    "typecheck": "tsc -p .",
    "test": "node scripts/dev-build.ts && node --test \"test/**/*.test.ts\" && node test/api/check.ts dist-dev",
    "test:visual": "node scripts/dev-build.ts && node test/visual/run.ts",
    "prepack": "npm run build && tsc -p tsconfig.build.json",
    "format": "prettier --write \"scripts/**/*.ts\" \"test/**/*.ts\" tsconfig.build.json"
  },
  "keywords": [
    "css",
    "css-framework",
    "dark-mode",
    "lightweight",
    "minimal",
    "native-html",
    "oklch",
    "semantic",
    "pico"
  ],
  "dependencies": {
    "browserslist": "^4.29.3",
    "culori": "^4.0.2",
    "lightningcss": "^1.33.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2"
  }
}
