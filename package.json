{
  "name": "@rusticstack/pico-reforged",
  "version": "2.0.0",
  "description": "Pico CSS rewritten in plain modern CSS: minimal styles for semantic HTML, with a small compiler for themes, scoping and purging",
  "author": "rusticstack",
  "license": "MIT",
  "homepage": "https://pico.rusticstack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusticstack/pico-reforged.git"
  },
  "bugs": {
    "url": "https://github.com/rusticstack/pico-reforged/issues"
  },
  "type": "module",
  "main": "css/pico.min.css",
  "style": "css/pico.min.css",
  "bin": {
    "pico-reforged": "dist/cli.js"
  },
  "files": [
    "css",
    "src",
    "dist",
    "ai",
    "skills",
    "AGENTS.md",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "style": "./css/pico.css",
      "default": "./css/pico.min.css"
    },
    "./classless": {
      "style": "./css/pico.classless.css",
      "default": "./css/pico.classless.min.css"
    },
    "./colors": {
      "style": "./css/pico.colors.css",
      "default": "./css/pico.colors.min.css"
    },
    "./extras": {
      "style": "./css/pico.extras.css",
      "default": "./css/pico.extras.min.css"
    },
    "./extras/*": {
      "style": "./css/extras/*.css",
      "default": "./css/extras/*.min.css"
    },
    "./css/*": "./css/*",
    "./src/*": "./src/*",
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "default": "./dist/postcss.js"
    },
    "./tokens.json": "./ai/tokens.json",
    "./components.json": "./ai/components.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "node scripts/generate.ts && node scripts/generate-ai.ts && node scripts/cli.ts matrix css",
    "generate": "node scripts/generate.ts",
    "generate:ai": "node scripts/generate-ai.ts",
    "dev": "node --watch-path=src --watch-path=scripts scripts/dev-build.ts",
    "test": "vp test",
    "test:api": "node scripts/dev-build.ts && node test/api/check.ts dist-dev",
    "test:visual": "node scripts/dev-build.ts && node test/visual/run.ts --ref test/reference/current --gate",
    "test:visual:parity": "node scripts/dev-build.ts && node test/visual/run.ts --ref test/reference/v2.1.1 --suffix parity",
    "test:extras": "node test/visual/extras.ts",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "tsc -p .",
    "pack": "vp pack",
    "prepack": "pnpm run build && vp pack"
  },
  "keywords": [
    "css",
    "css-framework",
    "dark-mode",
    "lightweight",
    "minimal",
    "native-html",
    "oklch",
    "pico",
    "semantic"
  ],
  "dependencies": {
    "browserslist": "^4.29.3",
    "culori": "^4.0.2",
    "lightningcss": "^1.33.0"
  },
  "peerDependencies": {
    "postcss": "^8.4.0",
    "vite": ">=6.3.0"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.30",
    "typescript": "^7.0.2",
    "vite-plus": "1.2.0"
  }
}
