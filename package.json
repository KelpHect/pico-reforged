{
  "name": "@rusticstack/pico-reforged",
  "version": "1.0.0-alpha.0",
  "description": "Pico CSS rewritten in plain modern CSS: minimal styles for semantic HTML, with a small compiler for themes, scoping and purging",
  "author": "rusticstack",
  "license": "MIT",
  "homepage": "https://pico.rusticstack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusticstack/pico-reforged.git"
  },
  "bugs": {
    "url": "https://github.com/rusticstack/pico-reforged/issues"
  },
  "type": "module",
  "main": "css/pico.min.css",
  "style": "css/pico.min.css",
  "bin": {
    "pico-reforged": "dist/cli.js"
  },
  "files": [
    "css",
    "src",
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": "./css/pico.min.css",
    "./css/*": "./css/*",
    "./src/*": "./src/*",
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "node scripts/generate.ts && node scripts/cli.ts matrix css",
    "generate": "node scripts/generate.ts",
    "dev": "node --watch-path=src --watch-path=scripts scripts/dev-build.ts",
    "test": "vp test",
    "test:api": "node scripts/dev-build.ts && node test/api/check.ts dist-dev",
    "test:visual": "node scripts/dev-build.ts && node test/visual/run.ts",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "tsc -p .",
    "pack": "vp pack",
    "prepack": "pnpm run build && vp pack"
  },
  "keywords": [
    "css",
    "css-framework",
    "dark-mode",
    "lightweight",
    "minimal",
    "native-html",
    "oklch",
    "pico",
    "semantic"
  ],
  "dependencies": {
    "browserslist": "^4.29.3",
    "culori": "^4.0.2",
    "lightningcss": "^1.33.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.2.0"
  }
}
